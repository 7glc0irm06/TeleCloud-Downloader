import os
import glob
import time
from urllib.parse import urlparse
import yt_dlp

from config import bot, stop_event, DOWNLOAD_DIR
from cookies import active_cookies_file
from utils import check_disk_space, get_free_space, cleanup_path, build_progress_msg, friendly_error
from uploaders.smart_dest import smart_dest


def _cancel_markup():
    from telebot import types
    m = types.InlineKeyboardMarkup()
    m.add(types.InlineKeyboardButton("❌ لغو", callback_data="cancel_task"))
    return m


def _is_ytdlp_url(url: str) -> bool:
    """بررسی میکنه آیا yt-dlp این URL رو پشتیبانی میکنه."""
    try:
        with yt_dlp.YoutubeDL({'quiet': True}) as ydl:
            for ie_cls in ydl._ies.values():
                try:
                    if ie_cls.suitable(url) and ie_cls.IE_NAME not in ('generic', 'Generic'):
                        return True
                except Exception:
                    continue
    except Exception:
        pass
    return False


def ytdlp_universal(task):
    """دانلود با yt-dlp برای سوشال مدیا و سایت‌های مختلف."""
    from config import tg_upload_mode
    chat_id = task['chat_id']
    dest    = task.get('dest') or ('tg' if chat_id in tg_upload_mode else 'gd')
    url     = task['url']

    if not check_disk_space():
        bot.send_message(chat_id, f"❌ فضای دیسک کافی نیست! {get_free_space()} آزاد.")
        return

    msg      = bot.send_message(chat_id, "🔗 دانلود...", reply_markup=_cancel_markup())
    last_upd = [time.time()]

    def hook(d):
        if stop_event.is_set():
            raise Exception("لغو")
        if d['status'] == 'downloading' and time.time() - last_upd[0] > 3:
            pct   = d.get('downloaded_bytes', 0)
            total = d.get('total_bytes') or d.get('total_bytes_estimate', 0)
            speed = d.get('speed', 0) or 0
            eta   = d.get('eta', 0) or 0
            pct_f = pct / total * 100 if total else 0
            try:
                bot.edit_message_text(
                    build_progress_msg(pct_f, pct, total, speed, eta),
                    chat_id, msg.message_id, reply_markup=_cancel_markup())
            except Exception:
                pass
            last_upd[0] = time.time()

    domain = urlparse(url).netloc.replace('www.', '').split('.')[0]
    folder = os.path.join(DOWNLOAD_DIR, domain)
    os.makedirs(folder, exist_ok=True)
    cf = active_cookies_file(url)

    ydl_opts = {
        'format':              task.get('format', 'bestvideo+bestaudio/best'),
        'outtmpl':             os.path.join(folder, '%(title)s.%(ext)s'),
        'merge_output_format': 'mp4',
        'progress_hooks':      [hook],
        'quiet':               True,
        'no_warnings':         True,
        'js_runtimes':         ['node'],
        'extractor_args':      {'youtube': {'js_runtimes': ['node']}},
        'noplaylist':          True,
        'nocheckcertificate':  True,
        'format_sort':         ['res', 'ext:mp4:m4a'],
        'http_headers': {
            'User-Agent':      'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept':          'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        },
        'extractor_args': {
            'twitter': {'api': ['graphql']},
        },
    }
    if cf:
        ydl_opts['cookiefile'] = cf

    fp = None
    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info      = ydl.extract_info(url, download=True)
            expected  = ydl.prepare_filename(info)
            base      = os.path.splitext(expected)[0]
            candidates = glob.glob(base + '.*')
            fp        = max(candidates, key=os.path.getmtime) if candidates else None
            if not fp:
                files = sorted(glob.glob(os.path.join(folder, '*')), key=os.path.getmtime)
                fp    = files[-1] if files else None
            if not fp:
                raise Exception("فایل پیدا نشد")

        try:
            bot.edit_message_text("☁️ آپلود...", chat_id, msg.message_id)
        except Exception:
            pass
        smart_dest(fp, msg, dest, folder_name=domain)

    except Exception as e:
        if fp:
            cleanup_path(fp)
        err = str(e)
        if "لغو" in err:
            try:
                bot.edit_message_text("🚫 دانلود لغو شد.", chat_id, msg.message_id)
            except Exception:
                pass
        else:
            text = f"❌ {friendly_error(err)}"
            try:
                bot.edit_message_text(text, chat_id, msg.message_id)
            except Exception:
                bot.send_message(chat_id, text)
            bot.send_message(chat_id, f"DEBUG ERROR:\n{err[:500]}")
