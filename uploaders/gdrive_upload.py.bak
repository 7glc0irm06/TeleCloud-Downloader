import os
import re
import subprocess
import time
import html

from config import bot, stop_event, DRIVE_FOLDER_ID
from utils import build_rich_progress_card, cleanup_path, fmt_size

# ──────────────────────────────────────────────────────────────
# نگاشت منبع → نام پوشه در گوگل درایو
# ──────────────────────────────────────────────────────────────
SOURCE_FOLDER_MAP = {
    # yt-dlp
    'youtube':          'YouTube',
    'youtube playlist': 'YouTube',
    'soundcloud':       'SoundCloud',
    'twitter':          'Twitter',
    'x':                'Twitter',
    'instagram':        'Instagram',
    'tiktok':           'TikTok',
    'vimeo':            'Vimeo',
    'twitch':           'Twitch',
    'reddit':           'Reddit',
    'facebook':         'Facebook',
    # موتورهای دیگر
    'torrent':          'Torrent',
    'direct':           'Direct',
    'telegram':         'Telegram',
    # fallback
    'ناشناس':           'Other',
    'other':            'Other',
}

def _source_to_folder(source: str) -> str:
    """منبع رو به نام پوشه تبدیل می‌کنه."""
    key = (source or '').lower().strip()
    return SOURCE_FOLDER_MAP.get(key, 'Other')


# ──────────────────────────────────────────────────────────────
# تبدیل لینک نمایش → لینک دانلود مستقیم
# ──────────────────────────────────────────────────────────────
def _to_direct_download_link(link: str) -> str:
    """
    لینک گوگل درایو رو به لینک دانلود مستقیم تبدیل می‌کنه.
    https://drive.google.com/file/d/FILE_ID/view
      → https://drive.google.com/uc?export=download&id=FILE_ID
    """
    if not link:
        return link
    # فرمت استاندارد: /file/d/ID/view یا /file/d/ID
    m = re.search(r'/file/d/([a-zA-Z0-9_-]+)', link)
    if m:
        file_id = m.group(1)
        return f"https://drive.google.com/uc?export=download&id={file_id}"
    # اگه از قبل uc?id= باشه، برش‌گردون
    if 'uc?id=' in link or 'export=download' in link:
        return link
    return link


# ──────────────────────────────────────────────────────────────
# helpers رنگ
# ──────────────────────────────────────────────────────────────
def _cancel_markup():
    from telebot import types
    m = types.InlineKeyboardMarkup()
    m.add(types.InlineKeyboardButton("❌ لغو", callback_data="cancel_task"))
    return m

def parse_rclone_speed(s):
    if not s: return 0
    s = s.upper()
    mul = 1
    if 'G' in s: mul = 1024**3
    elif 'M' in s: mul = 1024**2
    elif 'K' in s: mul = 1024
    val = re.sub(r'[^\d.]', '', s)
    return float(val) * mul if val else 0

def parse_rclone_eta(s):
    if not s: return 0
    h  = re.search(r'(\d+)h', s)
    m  = re.search(r'(\d+)m', s)
    sc = re.search(r'(\d+)s', s)
    eta = 0
    if h:  eta += int(h.group(1))  * 3600
    if m:  eta += int(m.group(1))  * 60
    if sc: eta += int(sc.group(1))
    return eta


# ──────────────────────────────────────────────────────────────
# آپلود اصلی
# ──────────────────────────────────────────────────────────────
def upload_to_gdrive_cancellable(
    path: str,
    status_msg,
    folder_name=None,
    is_folder=False,
    task_info=None,
):
    import config

    if task_info is None:
        task_info = {}

    chat_id = status_msg.chat.id
    source  = task_info.get('source', 'Other')
    quality = task_info.get('quality', '')
    title   = task_info.get('title', os.path.basename(path))

    # ── تعیین مسیر در درایو ──────────────────────────────────
    # ساختار: BotDownloader / <SourceFolder> / [folder_name/]
    source_folder = _source_to_folder(source)

    if folder_name:
        # مثلاً پلی‌لیست یا پوشه‌دار → BotDownloader/YouTube/pl_title/
        drive_dest = f"gdrive:BotDownloader/{source_folder}/{folder_name}"
    else:
        # فایل تکی → BotDownloader/YouTube/
        drive_dest = f"gdrive:BotDownloader/{source_folder}"

    # ── محاسبه حجم ───────────────────────────────────────────
    if not is_folder:
        total_size = os.path.getsize(path)
    else:
        total_size = sum(
            os.path.getsize(os.path.join(d, f))
            for d, _, fs in os.walk(path) for f in fs
        )

    # ── نمایش کارت اولیه ─────────────────────────────────────
    try:
        card = build_rich_progress_card(
            "☁️", title, 0, 0, total_size, 0, 0, source, quality)
        bot.edit_message_text(
            card, chat_id, status_msg.message_id,
            reply_markup=_cancel_markup())
    except Exception:
        pass

    # ── اجرای rclone ─────────────────────────────────────────
    cmd = [
        "rclone", "move", path, drive_dest,
        "--drive-root-folder-id", DRIVE_FOLDER_ID,
        "--progress",
    ]

    config.rclone_process = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, encoding='utf-8', errors='replace')

    last_update = time.time()

    while True:
        if stop_event.is_set():
            config.rclone_process.terminate()
            config.rclone_process = None
            cleanup_path(path)
            try:
                bot.edit_message_text(
                    "🚫 آپلود لغو شد.", chat_id, status_msg.message_id)
            except Exception:
                pass
            return

        line = config.rclone_process.stdout.readline()
        if not line and config.rclone_process.poll() is not None:
            break

        if time.time() - last_update > 4:
            m_pct = re.search(r'(\d+)%', line)
            m_spd = re.search(r',\s*([\d.]+\s*[a-zA-Z]+/s)', line)
            m_eta = re.search(r'ETA\s+([0-9hms]+)', line)

            if m_pct:
                pct        = float(m_pct.group(1))
                spd_raw    = m_spd.group(1) if m_spd else ""
                eta_raw    = m_eta.group(1) if m_eta else ""
                speed      = parse_rclone_speed(spd_raw)
                eta        = parse_rclone_eta(eta_raw)
                downloaded = (pct / 100.0) * total_size

                card = build_rich_progress_card(
                    "☁️", title, pct, downloaded, total_size,
                    speed, eta, source, quality)
                try:
                    bot.edit_message_text(
                        card, chat_id, status_msg.message_id,
                        reply_markup=_cancel_markup())
                except Exception:
                    pass
                last_update = time.time()

    ret = config.rclone_process.wait()
    config.rclone_process = None
    cleanup_path(path)

    name = os.path.basename(path)

    if ret == 0:
        # ── دریافت لینک فایل ─────────────────────────────────
        try:
            bot.edit_message_text(
                "⌛ در حال دریافت لینک دانلود از گوگل درایو...",
                chat_id, status_msg.message_id)
        except Exception:
            pass

        try:
            if is_folder:
                remote_file_path = drive_dest
            else:
                remote_file_path = drive_dest.rstrip('/') + '/' + name

            lr = subprocess.run(
                ["rclone", "link", remote_file_path,
                 "--drive-root-folder-id", DRIVE_FOLDER_ID],
                capture_output=True, text=True, timeout=30)

            raw_link   = lr.stdout.strip() if lr.returncode == 0 else None
            # تبدیل به لینک دانلود مستقیم
            direct_link = _to_direct_download_link(raw_link) if raw_link else None

            safe_title = html.escape(title)
            folder_display = f"BotDownloader/{source_folder}" + (f"/{folder_name}" if folder_name else "")

            final_txt = (
                f"✅ آپلود به گوگل درایو تموم شد!\n"
                f"📄 {safe_title}\n"
                f"📦 {fmt_size(total_size)} • {source} {quality}\n"
                f"📂 {html.escape(folder_display)}\n"
            )
            if direct_link:
                final_txt += f"⬇️ <a href='{direct_link}'>دانلود مستقیم</a>"
            elif raw_link:
                final_txt += f"☁️ <a href='{raw_link}'>مشاهده در درایو</a>"
            else:
                final_txt += "⚠️ (خطا در دریافت لینک)"

            try:
                bot.edit_message_text(
                    final_txt, chat_id, status_msg.message_id,
                    parse_mode='HTML', disable_web_page_preview=True)
            except Exception:
                bot.send_message(
                    chat_id, final_txt,
                    parse_mode='HTML', disable_web_page_preview=True)

        except Exception as e:
            try:
                bot.edit_message_text(
                    f"✅ آپلود شد: {name}\n⚠️ خطا در لینک: {e}",
                    chat_id, status_msg.message_id)
            except Exception:
                pass
    else:
        try:
            bot.edit_message_text(
                "❌ خطا در آپلود به گوگل درایو.", chat_id, status_msg.message_id)
        except Exception:
            pass


# ──────────────────────────────────────────────────────────────
# wrapper قدیمی (برای سازگاری با telegram_upload کال‌ها)
# ──────────────────────────────────────────────────────────────
def upload_file_to_gdrive_folder(
    file_path: str,
    status_msg,
    folder_name="Telegram",
    task_info=None,
):
    if task_info is None:
        task_info = {}
    # اگه source نداره، از folder_name به عنوان source استفاده می‌کنیم
    if 'source' not in task_info:
        task_info['source'] = 'Telegram'
    upload_to_gdrive_cancellable(
        file_path, status_msg,
        folder_name=folder_name,
        task_info=task_info)